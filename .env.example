# Copy this file to .env.local (Vite convention) and fill in your values.
# .env.local is gitignored by default in a Vite project — never commit it.

# During Day 9-13 (local development), point at your local Laravel server:
VITE_API_URL=http://localhost:8001/api

# Once you deploy (Day 14), change this to your live Render URL instead:
# VITE_API_URL=https://water-skill-app-api.onrender.com/api
